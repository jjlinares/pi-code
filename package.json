{
  "name": "pi-code",
  "displayName": "Pi Code",
  "version": "0.1.0",
  "description": "Run Pi's native terminal UI inside VS Code.",
  "publisher": "local",
  "license": "MIT",
  "type": "module",
  "main": "./dist/extension.cjs",
  "categories": [
    "AI",
    "Other"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs --sourcemap",
    "dev": "pnpm build --watch",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build",
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "pnpm check && vsce package --no-dependencies --allow-missing-repository"
  },
  "contributes": {
    "commands": [
      {
        "command": "pi-code.open",
        "title": "Pi Code: Open",
        "icon": "$(terminal)"
      },
      {
        "command": "pi-code.newTerminal",
        "title": "Pi Code: New Terminal",
        "icon": "$(terminal-new)"
      },
      {
        "command": "pi-code.addSelectionToComposer",
        "title": "Pi Code: Add Selection to Composer"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pi-code.addSelectionToComposer",
          "group": "navigation@-1000",
          "when": "resourceScheme == file && editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Pi Code",
      "properties": {
        "pi-code.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the Pi executable. Leave empty to resolve pi from PATH."
        }
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.27.0"
}
